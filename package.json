    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "codegenConfig": {
    "name": "NativeWifiManagerSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
